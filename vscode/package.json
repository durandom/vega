  ],
  "activationEvents": [
    "onUri"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test",
    "package": "mkdir -p dist && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository --skip-license --out dist/vega-vscode.vsix"
