#!/bin/sh
# herdr-core `shell`: enter the toolbox and keep hc identity.
# `toolbox run` passes only a fixed env allowlist, so HC_* is lost; re-inject it.
# scripts/install-hc-toolbox-shell.sh replaces the container name below.
set -- $(env | grep '^HC_')
exec toolbox run -c "__TOOLBOX__" env "$@" zsh
